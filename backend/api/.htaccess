Options -MultiViews
RewriteEngine On

# Allow direct access to existing files/dirs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route /shops        → shops.php
# Route /shops/123    → shops.php  (id passed via URL, parsed in PHP)
# Route /reports/xyz  → reports.php
RewriteRule ^([a-zA-Z_-]+)(/.*)?$ $1.php [L,QSA]
